  "name": "Marine Ecology & Restoration — Survey and Restoration Crews",
  "schema": "smartcitix.programme/1",
  "stations": [
    {
      "app": "smartcity",
      "id": "me-kelp-transect-survey-and-photo-quadrats",
      "why": "The fixed transect as the unit of monitoring: the same pins, bearing, frame and camera settings every season, swum at a pace that does not tear the canopy it counts."
    },
    {
      "app": "smartcity",
      "id": "me-oyster-reef-monitoring-and-settlement-tiles",
      "why": "A tile's identity and wetness kept from the rack to the lab, and the fresh rack set back on the same footing at the same mark before the flood."
    },
    {
      "app": "smartcity",
      "id": "me-eelgrass-seed-collection-and-nursery",
      "why": "Collecting to a permit's share and keeping what was cut alive: shoots cut above the sheath, bags wet and cool, hung by their labels in a tank that never stops flowing."
    },
    {
      "app": "smartcity",
      "id": "me-water-column-sampling-from-a-small-boat",
      "why": "What makes a bottle of water evidence — the marks on the line, the rinses, the labels, the cold and the custody — on a low wet deck with the gate open."
    },
    {
      "app": "smartcity",
      "id": "me-tidal-marsh-channel-restoration-day",
      "why": "Working a marsh by hand inside three lines drawn before the crew arrived: the alignment, the buffer nobody crosses and the tide window the permit allows."
    },
    {
      "app": "smartcity",
      "id": "me-fish-visual-census-and-data-sheet",
      "why": "A count that means the same thing every season: one corridor, one pace, classes against a bar, counting only what crosses ahead, and the sheet written on the bottom."
    },
    {
      "app": "smartcity",
      "id": "me-shoreline-debris-and-microplastics-survey",
      "why": "A beach tallied before it is changed and a sand sample kept honest in the wind, with sharps to the kit by tongs and unknowns flagged for the call."
    },
    {
      "app": "smartcity",
      "id": "me-invasive-species-identification-and-reporting",
      "why": "How a sighting becomes a record: photographed to protocol, positioned, sampled only as permitted and reported to the named body before anything is touched or said."
    }
  ],
  "summary": "Eight field methods a marine ecology and restoration crew runs on any survey or planting day: a kelp transect and its photo quadrats, a settlement-tile swap on a shellfish reef, seed collection and a flow-through nursery, water column sampling from a small boat, a hand-crew day opening a marsh channel, a fish visual census, a shoreline debris and microplastics survey, and the reporting method for a sighting that does not match the card. Every station teaches how a measurement is made repeatable and how a crew stays safe making it; none asserts a fact about any bay, species, count or date.",
  "union": "AFSCME and SEIU 1021 agency and nonprofit field staff, UPTE-CWA research technicians and LIUNA habitat crews, as training bodies"
}
