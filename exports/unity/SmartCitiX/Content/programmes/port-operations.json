  "name": "Port and Terminal Operations",
  "schema": "smartcitix.programme/1",
  "stations": [
    {
      "app": "smartcity",
      "id": "mooring-line",
      "why": "Taking the lines: snap-back zones and the bight nobody stands in."
    },
    {
      "app": "smartcity",
      "id": "bunkering-watch",
      "why": "Fuel transfer as person in charge, with the deck contained before the hose comes aboard."
    },
    {
      "app": "smartcity",
      "id": "container-lashing",
      "why": "Deck stow: every twist-lock proven and the rods to the pattern the manual calls for."
    },
    {
      "app": "smartcity",
      "id": "dock-crane",
      "why": "The crane over all of it, with the lashing gang's positions as the constraint."
    },
    {
      "app": "smartcity",
      "id": "vessel-gangway-and-hatch-cover-safety",
      "why": "Going aboard to work her: the gangway and its net, the hatch cover opened with nobody in its fold, and the hold's air read before anyone climbs down."
    },
    {
      "app": "smartcity",
      "id": "po-lashing-gear-inspection-and-tagging",
      "why": "The gear before it ever carries a load: a cracked rod caught in the rack, the pattern checked against the plan, and the gang held clear while the spreader swings overhead."
    },
    {
      "app": "smartcity",
      "id": "po-yard-hostler-and-pedestrian-separation",
      "why": "The yard tractor's own lane, where the horn comes before the back and the marked crossing is the one place a driver and a longshoreman are both expected to be."
    }
  ],
  "summary": "A ship comes alongside, is secured, is fuelled, is worked and leaves. Its stations follow that order, each with a different way to put oil or steel where it should not be.",
  "union": "ILWU longshore, MEBA and SIU marine engineers, IBT terminal drivers"
}
