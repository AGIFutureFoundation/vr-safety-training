{
  "version": "ros-assist/1",
  "synthetic": true,
  "consent": null,
  "hardware_run": false,
  "layout": "ROS 2 message type names, compact columnar JSON per topic; not a rosbag; ROS not required",
  "hz": 10,
  "steps": 40,
  "governor": {
    "protective_stop_m": 0.5,
    "reduced_zone_m": 1.5,
    "reduced_speed_mps": 0.25,
    "estop": "zero speed while held"
  },
  "styles": {
    "cobot-arm": {
      "label": "Collaborative arm",
      "max_speed_mps": 0.5,
      "topics": {
        "/joint_states": "sensor_msgs/msg/JointState",
        "/safety/human_distance": "sensor_msgs/msg/Range",
        "/estop": "std_msgs/msg/Bool"
      },
      "episodes": 66,
      "file": "cobot-arm.json"
    },
    "amr": {
      "label": "Autonomous mobile robot",
      "max_speed_mps": 1.2,
      "topics": {
        "/cmd_vel": "geometry_msgs/msg/Twist",
        "/odom": "nav_msgs/msg/Odometry",
        "/safety/human_distance": "sensor_msgs/msg/Range",
        "/estop": "std_msgs/msg/Bool"
      },
      "episodes": 118,
      "file": "amr.json"
    },
    "gantry": {
      "label": "Gantry hoist",
      "max_speed_mps": 0.8,
      "topics": {
        "/trolley/position": "std_msgs/msg/Float64",
        "/hoist/load": "std_msgs/msg/Float64",
        "/safety/human_distance": "sensor_msgs/msg/Range",
        "/estop": "std_msgs/msg/Bool"
      },
      "episodes": 54,
      "file": "gantry.json"
    },
    "quadruped": {
      "label": "Inspection quadruped",
      "max_speed_mps": 1,
      "topics": {
        "/cmd_vel": "geometry_msgs/msg/Twist",
        "/inspection/reading": "std_msgs/msg/Float64",
        "/safety/human_distance": "sensor_msgs/msg/Range",
        "/estop": "std_msgs/msg/Bool"
      },
      "episodes": 68,
      "file": "quadruped.json"
    }
  },
  "style_by_category": {
    "Manufacturing & Automation": "cobot-arm",
    "Culinary & Hospitality": "cobot-arm",
    "Sewing & Garment Trades": "cobot-arm",
    "Surface Prep & Coatings": "cobot-arm",
